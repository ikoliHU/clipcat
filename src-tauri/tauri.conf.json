{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipCat",
  "version": "0.2.0",
  "identifier": "hu.peter.clipcat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipCat",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#141416"
      },
      {
        "label": "toast",
        "title": "ClipCat értesítés",
        "url": "toast.html",
        "width": 380,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Peter",
    "shortDescription": "ShadowPlay-szerű visszajátszás-rögzítő"
  }
}
