{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipCat",
  "identifier": "hu.peter.clipcat",
  "build": {
    "frontendDist": "../ui-dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ClipCat",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#141416"
      },
      {
        "label": "toast",
        "title": "ClipCat notification",
        "url": "toast.html",
        "width": 380,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' clipcat: http://clipcat.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src clipcat: http://clipcat.localhost; connect-src ipc: http://ipc.localhost ws://localhost:5173; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Peter",
    "shortDescription": "ShadowPlay-style replay recorder"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/catninth/clipcat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNzg3MTVFQTlDRjVCN0MKUldSOFc4K3BYbkY0THowMW0wREp1UUErU2RkZ0tjSUw0dHV4STl5dmZuMGdDWkxLbWFTQ1h4WVMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
